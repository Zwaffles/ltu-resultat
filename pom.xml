<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Parent project for D0031N Assignment 3, Group 10.
        Spring Boot's parent POM manages the versions of all Spring, Hibernate,
        PostgreSQL, Flyway and Jackson dependencies, so the modules declare
        dependencies without version numbers.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.6</version>
        <relativePath/>
    </parent>

    <groupId>se.ltu.grupp10</groupId>
    <artifactId>ltu-resultat</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>ltu-resultat</name>
    <description>Registrera studieresultat: REST-webbtjänster för Epok, StudentITS, Ladok och Canvas</description>

    <modules>
        <module>epok-service</module>
        <module>studentits-service</module>
        <module>ladok-service</module>
        <module>canvas-service</module>
        <module>resultat-gui</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- JavaFX 21 is the long-term-support line that runs on Java 21 -->
        <javafx.version>21.0.9</javafx.version>
        <javafx.maven.plugin.version>0.0.8</javafx.maven.plugin.version>
    </properties>
</project>
